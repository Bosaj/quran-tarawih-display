{
  "name": "quran-tarawih-display",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Shows the verse the imam is reciting, live on the mosque screen during Tarawih.",
  "author": "Oussama Elhadji <oussousselhadji@gmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "corpus": "node tools/build-corpus.mjs",
    "corpus:verify": "node tools/verify-corpus.mjs",
    "eval": "node tools/eval.mjs",
    "lan": "node tools/lan-server.mjs",
    "e2e": "node e2e/flow.mjs"
  },
  "dependencies": {
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "playwright": "1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
